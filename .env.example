PORT=4310
DATA_DIR=./data
APP_ORIGIN=http://localhost:4310
SESSION_SECRET=change-me
APP_USERNAME=admin
APP_PASSWORD=change-me-too
PROVIDER=zalo-web

PORTAL_URL=https://portal.tehui.io.vn
WORKSPACE_URL=https://zl.tehui.io.vn
PORTAL_COOKIE_DOMAIN=.tehui.io.vn
PORTAL_COOKIE_SECURE=true
PORTAL_COOKIE_SAMESITE=Lax
PORTAL_JWT_SECRET=change-me-portal
PORTAL_READ_SOURCE=auto
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/tehui_portal

# Dedicated int-chat bridge.
# Use the same shared secret in int-chat ZALO_BRIDGE_SECRET.
CHATBOT_WEBHOOK_URL=http://localhost:4100/webhooks/zalo
CHATBOT_BRIDGE_SECRET=change-me-zalo-bridge
# Empty = all connected Zalo accounts. Or comma-separated Zalo account IDs.
CHATBOT_BRIDGE_ACCOUNT_IDS=
CHATBOT_BRIDGE_ALLOW_GROUPS=false
CHATBOT_BRIDGE_TIMEOUT_MS=8000
